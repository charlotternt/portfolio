{"ast":null,"code":"export default {\n  name: \"stack_\",\n  mounted() {\n    const techs = document.querySelectorAll(\".tech\");\n    const observer = new IntersectionObserver(entries => {\n      entries.forEach((entry, index) => {\n        if (entry.isIntersecting) {\n          setTimeout(() => {\n            entry.target.classList.add(\"show\");\n          }, index * 150);\n        }\n      });\n    }, {\n      threshold: 0.3\n    });\n    techs.forEach(tech => {\n      observer.observe(tech);\n    });\n  }\n};","map":{"version":3,"names":["name","mounted","techs","document","querySelectorAll","observer","IntersectionObserver","entries","forEach","entry","index","isIntersecting","setTimeout","target","classList","add","threshold","tech","observe"],"sources":["/Users/charlotte/portfolio/src/components/stack.vue"],"sourcesContent":["<template>\n  <div class=\"stack\">\n    <h2>Mes Compétences</h2>\n\n    <p>\n      Au cours de mes études j'ai pu découvrir et apprendre différents langages.\n      Nous avions commencer par voir les bases en HTML, CSS ,PHP et Javascript\n      ensuite on a du réaliser des petits projets en react, vue js ,python,\n      java, ruby. Je suis plus à l'aise avec le language Vue Js.\n    </p>\n    <div class=\"images-container\">\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/html.png\" />\n        <span>HTML</span>\n      </div>\n\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/css.png\" />\n        <span>CSS</span>\n      </div>\n\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/php.png\" />\n        <span>PHP</span>\n      </div>\n\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/javascript.svg\" />\n        <span>JavaScript</span>\n      </div>\n\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/laravel.png\" />\n        <span>Laravel</span>\n      </div>\n\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/vuejs.png\" />\n        <span>Vue JS</span>\n      </div>\n\n      <div class=\"tech\">\n        <img class=\"logo\" src=\"../assets/react.png\" />\n        <span>React</span>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"stack_\",\n\n  mounted() {\n    const techs = document.querySelectorAll(\".tech\");\n\n    const observer = new IntersectionObserver(\n      (entries) => {\n        entries.forEach((entry, index) => {\n          if (entry.isIntersecting) {\n            setTimeout(() => {\n              entry.target.classList.add(\"show\");\n            }, index * 150);\n          }\n        });\n      },\n      { threshold: 0.3 }\n    );\n\n    techs.forEach((tech) => {\n      observer.observe(tech);\n    });\n  },\n};\n</script>\n\n<style>\n.stack {\n  padding: 100px 50px;\n  background-color: #f5f7ff;\n}\n\n.images-container {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 30px;\n  margin-top: 50px;\n}\n\n.tech {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n\n  width: 120px;\n  height: 120px;\n\n  background: white;\n  border-radius: 15px;\n\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);\n\n  opacity: 0;\n  transform: translateY(40px);\n  transition: all 0.6s ease;\n}\n\n.tech.show {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.tech img {\n  width: 45px;\n  height: 45px;\n  margin-bottom: 10px;\n}\n\n.tech span {\n  font-size: 14px;\n  color: #444;\n  font-weight: 500;\n}\n\n.tech:hover {\n  transform: translateY(-8px);\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);\n}\n</style>\n"],"mappings":"AAkDA,eAAe;EACbA,IAAI,EAAE,QAAQ;EAEdC,OAAOA,CAAA,EAAG;IACR,MAAMC,KAAI,GAAIC,QAAQ,CAACC,gBAAgB,CAAC,OAAO,CAAC;IAEhD,MAAMC,QAAO,GAAI,IAAIC,oBAAoB,CACtCC,OAAO,IAAK;MACXA,OAAO,CAACC,OAAO,CAAC,CAACC,KAAK,EAAEC,KAAK,KAAK;QAChC,IAAID,KAAK,CAACE,cAAc,EAAE;UACxBC,UAAU,CAAC,MAAM;YACfH,KAAK,CAACI,MAAM,CAACC,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;UACpC,CAAC,EAAEL,KAAI,GAAI,GAAG,CAAC;QACjB;MACF,CAAC,CAAC;IACJ,CAAC,EACD;MAAEM,SAAS,EAAE;IAAI,CACnB,CAAC;IAEDd,KAAK,CAACM,OAAO,CAAES,IAAI,IAAK;MACtBZ,QAAQ,CAACa,OAAO,CAACD,IAAI,CAAC;IACxB,CAAC,CAAC;EACJ;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}