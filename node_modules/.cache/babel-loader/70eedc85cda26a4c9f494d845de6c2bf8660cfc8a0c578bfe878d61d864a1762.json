{"ast":null,"code":"import movieImg from \"../assets/movie.png\";\nimport quizzImg from \"../assets/quizz.png\";\nimport weatherImg from \"../assets/weather.png\";\nimport calculatorImg from \"../assets/calculator.png\";\nimport ecommerceImg from \"../assets/ecommerce.png\";\nimport tictactoeImg from \"../assets/tictactoe.png\";\nconst name = \"project_\";\nexport default {\n  __name: 'project',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const projects = [{\n      title: \"Movie\",\n      tech: \"Vue.js\",\n      description: \"Site affichant les sorties de films via l'API TMDB\",\n      url: \"https://movieapitmbd.netlify.app\",\n      image: movieImg,\n      alt: \"movie\"\n    }, {\n      title: \"Quizz\",\n      tech: \"Vue.js\",\n      description: \"Site d'un quizz avec Open Trivia Database\",\n      url: \"https://quizopentriviadatabase.netlify.app\",\n      image: quizzImg,\n      alt: \"quizz\"\n    }, {\n      title: \"Weather App\",\n      tech: \"Vue.js • CSS\",\n      description: \"Site affichant la météo par recherche de ville\",\n      url: \"https://effervescent-kangaroo-6c4cd4.netlify.app\",\n      image: weatherImg,\n      alt: \"weather app\"\n    }, {\n      title: \"Age Calculator\",\n      tech: \"HTML • CSS • JS\",\n      description: \"Challenge Frontend Mentor : calculateur d'âge\",\n      url: \"https://challenge-age-calculator.netlify.app\",\n      image: calculatorImg,\n      alt: \"calculator app\"\n    }, {\n      title: \"Product list with card\",\n      tech: \"HTML • CSS • JS\",\n      description: \"Challenge Frontend Mentor : site de commande de desserts.\",\n      url: \"https://challenge-product-items.netlify.app\",\n      image: ecommerceImg,\n      alt: \"ecommerce\"\n    }, {\n      title: \"Tic Tac Toe\",\n      tech: \"Vue.js • CSS\",\n      description: \"Jeu Tic Tac Toe avec un mode contre une IA\",\n      url: \"https://tictactoeinvuejs.netlify.app\",\n      image: tictactoeImg,\n      alt: \"Tic Tac Toe\"\n    }];\n    const __returned__ = {\n      name,\n      projects,\n      get movieImg() {\n        return movieImg;\n      },\n      get quizzImg() {\n        return quizzImg;\n      },\n      get weatherImg() {\n        return weatherImg;\n      },\n      get calculatorImg() {\n        return calculatorImg;\n      },\n      get ecommerceImg() {\n        return ecommerceImg;\n      },\n      get tictactoeImg() {\n        return tictactoeImg;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["movieImg","quizzImg","weatherImg","calculatorImg","ecommerceImg","tictactoeImg","name","projects","title","tech","description","url","image","alt"],"sources":["/Users/charlotte/portfolio/src/components/project.vue"],"sourcesContent":["<template>\n  <div class=\"container\">\n    <h2>Mes projets</h2>\n    <div class=\"projects\">\n      <div class=\"project\" v-for=\"project in projects\" :key=\"project.title\">\n        <a :href=\"project.url\" target=\"_blank\">\n          <div class=\"overlay\">\n            <img :src=\"project.image\" :alt=\"project.alt\" class=\"picture\" />\n            <div class=\"text\">{{ project.title }}</div>\n          </div>\n        </a>\n        <div class=\"project-details\">\n          <h2>{{ project.title }}</h2>\n          <p class=\"project-tech\">{{ project.tech }}</p>\n          <p>{{ project.description }}</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport movieImg from \"../assets/movie.png\";\nimport quizzImg from \"../assets/quizz.png\";\nimport weatherImg from \"../assets/weather.png\";\nimport calculatorImg from \"../assets/calculator.png\";\nimport ecommerceImg from \"../assets/ecommerce.png\";\nimport tictactoeImg from \"../assets/tictactoe.png\";\n\nconst name = \"project_\";\n\nconst projects = [\n  {\n    title: \"Movie\",\n    tech: \"Vue.js\",\n    description: \"Site affichant les sorties de films via l'API TMDB\",\n    url: \"https://movieapitmbd.netlify.app\",\n    image: movieImg,\n    alt: \"movie\",\n  },\n  {\n    title: \"Quizz\",\n    tech: \"Vue.js\",\n    description: \"Site d'un quizz avec Open Trivia Database\",\n    url: \"https://quizopentriviadatabase.netlify.app\",\n    image: quizzImg,\n    alt: \"quizz\",\n  },\n  {\n    title: \"Weather App\",\n    tech: \"Vue.js • CSS\",\n    description: \"Site affichant la météo par recherche de ville\",\n    url: \"https://effervescent-kangaroo-6c4cd4.netlify.app\",\n    image: weatherImg,\n    alt: \"weather app\",\n  },\n  {\n    title: \"Age Calculator\",\n    tech: \"HTML • CSS • JS\",\n    description: \"Challenge Frontend Mentor : calculateur d'âge\",\n    url: \"https://challenge-age-calculator.netlify.app\",\n    image: calculatorImg,\n    alt: \"calculator app\",\n  },\n  {\n    title: \"Product list with card\",\n    tech: \"HTML • CSS • JS\",\n    description: \"Challenge Frontend Mentor : site de commande de desserts.\",\n    url: \"https://challenge-product-items.netlify.app\",\n    image: ecommerceImg,\n    alt: \"ecommerce\",\n  },\n  {\n    title: \"Tic Tac Toe\",\n    tech: \"Vue.js • CSS\",\n    description: \"Jeu Tic Tac Toe avec un mode contre une IA\",\n    url: \"https://tictactoeinvuejs.netlify.app\",\n    image: tictactoeImg,\n    alt: \"Tic Tac Toe\",\n  },\n];\n</script>\n\n<style scoped>\n.container {\n  padding: 80px 20px;\n}\n\n.projects {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 40px;\n  margin-top: 50px;\n  justify-items: center;\n}\n\n.project {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 350px;\n  width: 100%;\n}\n\n.picture {\n  width: 100%;\n  height: auto;\n  border-radius: 5%;\n  transition: 0.3s ease;\n}\n\n.overlay {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  border-radius: 5%;\n  overflow: hidden;\n}\n\n.overlay::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0, 0, 0, 0.281);\n  transition: 0.3s ease;\n  opacity: 0;\n}\n\n.overlay:hover::after {\n  opacity: 1;\n}\n\n.text {\n  z-index: 1;\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: #6540ca;\n  font-size: 20px;\n  font-weight: bold;\n  visibility: hidden;\n  opacity: 0;\n  transition: visibility 0s, opacity 0.3s ease;\n}\n\n.overlay:hover .text {\n  visibility: visible;\n  opacity: 1;\n}\n\n.project-details {\n  text-align: center;\n  margin-top: 15px;\n}\n\n.project-details h2 {\n  margin-top: 0;\n}\n\n.project-details p {\n  margin-top: 5px;\n}\n\n.project-tech {\n  font-size: 14px;\n  color: black;\n  font-weight: 600;\n}\n\n@media (max-width: 768px) {\n  .projects {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (min-width: 1100px) {\n  .projects {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n</style>\n"],"mappings":"AAsBA,OAAOA,QAAQ,MAAM,qBAAqB;AAC1C,OAAOC,QAAQ,MAAM,qBAAqB;AAC1C,OAAOC,UAAU,MAAM,uBAAuB;AAC9C,OAAOC,aAAa,MAAM,0BAA0B;AACpD,OAAOC,YAAY,MAAM,yBAAyB;AAClD,OAAOC,YAAY,MAAM,yBAAyB;AAElD,MAAMC,IAAI,GAAG,UAAU;;;;;;;IAEvB,MAAMC,QAAQ,GAAG,CACf;MACEC,KAAK,EAAE,OAAO;MACdC,IAAI,EAAE,QAAQ;MACdC,WAAW,EAAE,oDAAoD;MACjEC,GAAG,EAAE,kCAAkC;MACvCC,KAAK,EAAEZ,QAAQ;MACfa,GAAG,EAAE;IACP,CAAC,EACD;MACEL,KAAK,EAAE,OAAO;MACdC,IAAI,EAAE,QAAQ;MACdC,WAAW,EAAE,2CAA2C;MACxDC,GAAG,EAAE,4CAA4C;MACjDC,KAAK,EAAEX,QAAQ;MACfY,GAAG,EAAE;IACP,CAAC,EACD;MACEL,KAAK,EAAE,aAAa;MACpBC,IAAI,EAAE,cAAc;MACpBC,WAAW,EAAE,gDAAgD;MAC7DC,GAAG,EAAE,kDAAkD;MACvDC,KAAK,EAAEV,UAAU;MACjBW,GAAG,EAAE;IACP,CAAC,EACD;MACEL,KAAK,EAAE,gBAAgB;MACvBC,IAAI,EAAE,iBAAiB;MACvBC,WAAW,EAAE,+CAA+C;MAC5DC,GAAG,EAAE,8CAA8C;MACnDC,KAAK,EAAET,aAAa;MACpBU,GAAG,EAAE;IACP,CAAC,EACD;MACEL,KAAK,EAAE,wBAAwB;MAC/BC,IAAI,EAAE,iBAAiB;MACvBC,WAAW,EAAE,2DAA2D;MACxEC,GAAG,EAAE,6CAA6C;MAClDC,KAAK,EAAER,YAAY;MACnBS,GAAG,EAAE;IACP,CAAC,EA