{"ast":null,"code":"export default {\n  name: \"stack_\"\n};","map":{"version":3,"names":["name"],"sources":["/Users/charlotte/portfolio/src/components/stack.vue"],"sourcesContent":["<template>\n  <div>\n    <p>\n      Je suis développeuse web passionnée par le JavaScript et la création\n      d'interfaces interactives. Je développe principalement avec HTML, CSS,\n      JavaScript et Vue.js. Je cherche une opportunité pour continuer à\n      apprendre et contribuer à des projets web.\n    </p>\n\n    <div class=\"card-container\">\n      <div class=\"card\">\n        <img src=\"../assets/desktop.svg\" class=\"icon\" />\n        <h3>HelloCSE</h3>\n        <p>Lyon, 69007</p>\n        <p>De septembre 2022 à Novembre 2023</p>\n      </div>\n      <div class=\"card\">\n        <img src=\"../assets/school.svg\" class=\"icon\" />\n        <h3>Diplôme intégratrice/développeuse web</h3>\n        <p>Epitech</p>\n        <p>Lyon, 69007</p>\n        <p>De Novembre 2021 à Novembre 2023</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"stack\">\n    <p>\n      Au cours de mes études j'ai pu découvrir et apprendre quelques langages.\n      Nous avions commencer par voir les bases en HTML, CSS ,PHP et Javascript\n      ensuite on a du réaliser des petits projets en react, vue js ,python,\n      java, ruby. Je suis plus à l'aise avec le language Vue Js.\n    </p>\n    <div class=\"images-container\">\n      <img src=\"../assets/html.png\" />\n      <img src=\"../assets/css.png\" />\n      <img src=\"../assets/php.png\" />\n      <img src=\"../assets/javascript.svg\" />\n      <img src=\"../assets/laravel.png\" />\n      <img src=\"../assets/vuejs.png\" />\n      <img src=\"../assets/react.png\" />\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"stack_\",\n};\n</script>\n\n<style>\n.stack {\n  text-align: left;\n  margin: 100px;\n}\n\n.images-container {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  margin-top: 20px;\n}\n\n.images-container img {\n  margin: 10px;\n  width: 50px;\n  height: 50px;\n}\n</style>\n"],"mappings":"AA6CA,eAAe;EACbA,IAAI,EAAE;AACR,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}