{"ast":null,"code":"export default {\n  name: \"stack_\",\n  mounted() {\n    const logos = document.querySelectorAll(\".logo\");\n    const observer = new IntersectionObserver(entries => {\n      entries.forEach((entry, index) => {\n        if (entry.isIntersecting) {\n          setTimeout(() => {\n            entry.target.classList.add(\"show\");\n          }, index * 150);\n        }\n      });\n    }, {\n      threshold: 0.3\n    });\n    logos.forEach(logo => {\n      observer.observe(logo);\n    });\n  }\n};","map":{"version":3,"names":["name","mounted","logos","document","querySelectorAll","observer","IntersectionObserver","entries","forEach","entry","index","isIntersecting","setTimeout","target","classList","add","threshold","logo","observe"],"sources":["/Users/charlotte/portfolio/src/components/stack.vue"],"sourcesContent":["<template>\n  <div class=\"stack\">\n    <h2>Mes Compétences</h2>\n\n    <p>\n      Au cours de mes études j'ai pu découvrir et apprendre différents langages.\n      Nous avions commencer par voir les bases en HTML, CSS ,PHP et Javascript\n      ensuite on a du réaliser des petits projets en react, vue js ,python,\n      java, ruby. Je suis plus à l'aise avec le language Vue Js.\n    </p>\n\n    <div class=\"images-container\">\n      <img class=\"logo\" src=\"../assets/html.png\" />\n      <img class=\"logo\" src=\"../assets/css.png\" />\n      <img class=\"logo\" src=\"../assets/php.png\" />\n      <img class=\"logo\" src=\"../assets/javascript.svg\" />\n      <img class=\"logo\" src=\"../assets/laravel.png\" />\n      <img class=\"logo\" src=\"../assets/vuejs.png\" />\n      <img class=\"logo\" src=\"../assets/react.png\" />\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"stack_\",\n\n  mounted() {\n    const logos = document.querySelectorAll(\".logo\");\n\n    const observer = new IntersectionObserver(\n      (entries) => {\n        entries.forEach((entry, index) => {\n          if (entry.isIntersecting) {\n            setTimeout(() => {\n              entry.target.classList.add(\"show\");\n            }, index * 150);\n          }\n        });\n      },\n      { threshold: 0.3 }\n    );\n\n    logos.forEach((logo) => {\n      observer.observe(logo);\n    });\n  },\n};\n</script>\n\n<style>\n.stack {\n  text-align: left;\n}\n\n.images-container {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  margin-top: 20px;\n}\n\n.images-container img {\n  margin: 10px;\n  width: 50px;\n  height: 50px;\n}\n</style>\n"],"mappings":"AAwBA,eAAe;EACbA,IAAI,EAAE,QAAQ;EAEdC,OAAOA,CAAA,EAAG;IACR,MAAMC,KAAI,GAAIC,QAAQ,CAACC,gBAAgB,CAAC,OAAO,CAAC;IAEhD,MAAMC,QAAO,GAAI,IAAIC,oBAAoB,CACtCC,OAAO,IAAK;MACXA,OAAO,CAACC,OAAO,CAAC,CAACC,KAAK,EAAEC,KAAK,KAAK;QAChC,IAAID,KAAK,CAACE,cAAc,EAAE;UACxBC,UAAU,CAAC,MAAM;YACfH,KAAK,CAACI,MAAM,CAACC,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;UACpC,CAAC,EAAEL,KAAI,GAAI,GAAG,CAAC;QACjB;MACF,CAAC,CAAC;IACJ,CAAC,EACD;MAAEM,SAAS,EAAE;IAAI,CACnB,CAAC;IAEDd,KAAK,CAACM,OAAO,CAAES,IAAI,IAAK;MACtBZ,QAAQ,CAACa,OAAO,CAACD,IAAI,CAAC;IACxB,CAAC,CAAC;EACJ;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}