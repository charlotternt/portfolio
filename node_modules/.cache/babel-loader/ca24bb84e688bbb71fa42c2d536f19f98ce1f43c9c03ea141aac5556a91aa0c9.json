e Calculator\",\n    tech: \"HTML • CSS • JS\",\n    description: \"Challenge Frontend Mentor : calculateur d'âge\",\n    url: \"https://challenge-age-calculator.netlify.app\",\n    image: calculatorImg,\n    alt: \"calculator app\",\n  },\n  {\n    title: \"Product list with card\",\n    tech: \"HTML • CSS • JS\",\n    description: \"Challenge Frontend Mentor : site de commande de desserts.\",\n    url: \"https://challenge-product-items.netlify.app\",\n    image: ecommerceImg,\n    alt: \"ecommerce\",\n  },\n  {\n    title: \"Tic Tac Toe\",\n    tech: \"Vue.js • CSS\",\n    description: \"Jeu Tic Tac Toe avec un mode contre une IA\",\n    url: \"https://tictactoeinvuejs.netlify.app\",\n    image: tictactoeImg,\n    alt: \"Tic Tac Toe\",\n  },\n];\n</script>\n\n<style scoped>\n.container {\n  padding: 80px 20px;\n}\n\n.projects {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 40px;\n  margin-top: 50px;\n  justify-items: center;\n}\n\n.project {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 350px;\n  width: 100%;\n}\n\n.picture {\n  width: 100%;\n  height: auto;\n  border-radius: 5%;\n  transition: 0.3s ease;\n}\n\n.overlay {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  border-radius: 5%;\n  overflow: hidden;\n}\n\n.overlay::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0, 0, 0, 0.281);\n  transition: 0.3s ease;\n  opacity: 0;\n}\n\n.overlay:hover::after {\n  opacity: 1;\n}\n\n.text {\n  z-index: 1;\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: #6540ca;\n  font-size: 20px;\n  font-weight: bold;\n  visibility: hidden;\n  opacity: 0;\n  transition: visibility 0s, opacity 0.3s ease;\n}\n\n.overlay:hover .text {\n  visibility: visible;\n  opacity: 1;\n}\n\n.project-details {\n  text-align: center;\n  margin-top: 15px;\n}\n\n.project-details h2 {\n  margin-top: 0;\n}\n\n.project-details p {\n  margin-top: 5px;\n}\n\n.project-tech {\n  font-size: 14px;\n  color: black;\n  font-weight: 600;\n}\n\n@media (max-width: 768px) {\n  .projects {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (min-width: 1100px) {\n  .projects {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAW;;EAEfA,KAAK,EAAC;AAAU;;;EAGVA,KAAK,EAAC;AAAS;;;EAEbA,KAAK,EAAC;AAAM;;EAGhBA,KAAK,EAAC;AAAiB;;EAEvBA,KAAK,EAAC;AAAc;;uBAZ/BC,mBAAA,CAiBM,OAjBNC,UAiBM,G,0BAhBJC,mBAAA,CAAoB,YAAhB,aAAW,qBACfA,mBAAA,CAcM,OAdNC,UAcM,I,cAbJH,mBAAA,CAYMI,SAAA,QAAAC,WAAA,CAZiCC,MAAA,CAAAC,QAAQ,EAAnBC,OAAO;WAAnCN,mBAAA,CAYM;MAZDH,KAAK,EAAC,SAAS;MAA8BU,GAAG,EAAED,OAAO,CAACE;QAC7DR,mBAAA,CAKI;MALAS,IAAI,EAAEH,OAAO,CAACI,GAAG;MAAEC,MAAM,EAAC;QAC5BX,mBAAA,CAGM,OAHNY,UAGM,GAFJZ,mBAAA,CAA+D;MAAzDa,GAAG,EAAEP,OAAO,CAACQ,KAAK;MAAGC,GAAG,EAAET,OAAO,CAACS,GAAG;MAAElB,KAAK,EAAC;yCACnDG,mBAAA,CAA2C,OAA3CgB,UAA2C,EAAAC,gBAAA,CAAtBX,OAAO,CAACE,KAAK,iB,gCAGtCR,mBAAA,CAIM,OAJNkB,UAIM,GAHJlB,mBAAA,CAA4B,YAAAiB,gBAAA,CAArBX,OAAO,CAACE,KAAK,kBACpBR,mBAAA,CAA8C,KAA9CmB,UAA8C,EAAAF,gBAAA,CAAnBX,OAAO,CAACc,IAAI,kBACvCpB,mBAAA,CAAgC,WAAAiB,gBAAA,CAA1BX,OAAO,CAACe,WAAW,iB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}