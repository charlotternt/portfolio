{"ast":null,"code":"export default {\n  name: \"project_\"\n};","map":{"version":3,"names":["name"],"sources":["/Users/charlotte/portfolio/src/components/project.vue"],"sourcesContent":["<template>\n  <div class=\"container\">\n    <h2>Mes projets</h2>\n    <div class=\"projects\">\n      <div class=\"project\">\n        <a\n          href=\"https://effervescent-kangaroo-6c4cd4.netlify.app\"\n          target=\"_blank\"\n        >\n          <div class=\"overlay\">\n            <img\n              src=\"../assets/weather.png\"\n              alt=\"weather app\"\n              class=\"picture\"\n            />\n            <div class=\"text\">Weather App</div>\n          </div>\n        </a>\n        <div class=\"project-details\">\n          <h2>Weather App</h2>\n          <p>Il s'agit d'une page web faite en Vue Js qui donne la météo.</p>\n        </div>\n      </div>\n      <div class=\"project\">\n        <a href=\"https://challenge-age-calculator.netlify.app\" target=\"_blank\">\n          <div class=\"overlay\">\n            <img\n              src=\"../assets/calculator.png\"\n              alt=\"calculator app\"\n              class=\"picture\"\n            />\n            <div class=\"text\">Age Calculator</div>\n          </div>\n        </a>\n        <div class=\"project-details\">\n          <h2>Age Calculator</h2>\n          <p>\n            C'est une page web qui permet de calculer l'âge en fonction de la\n            date de naissance. Je l'ai réalisé en HTML et JS.\n          </p>\n        </div>\n      </div>\n      <div class=\"project\">\n        <a href=\"https://challenge-product-items.netlify.app\" target=\"_blank\">\n          <div class=\"overlay\">\n            <img\n              src=\"../assets/ecommerce.png\"\n              alt=\"ecommerce\"\n              class=\"picture\"\n            />\n            <div class=\"text\">Commande de desserts</div>\n          </div>\n        </a>\n        <div class=\"project-details\">\n          <h2>Commande de desserts</h2>\n          <p>\n            C'est une page web qui simule une commande de desserts. Je l'ai\n            réalisé en HTML, CSS et JS.\n          </p>\n        </div>\n        <div class=\"project\">\n          <a href=\"https://tictactoeinvuejs.netlify.app\" target=\"_blank\">\n            <div class=\"overlay\">\n              <img\n                src=\"../assets/tictactoe.png\"\n                alt=\"Tic Tac Toe\"\n                class=\"picture\"\n              />\n              <div class=\"text\">Tic Tac Toe</div>\n            </div>\n          </a>\n          <div class=\"project-details\">\n            <h2>Tic Tac Toe</h2>\n            <p>\n              Création du jeu Tic Tac Toe avec la possibilité de jouer contre\n              une ia. Je l'ai réalisé en VueJS.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"project_\",\n};\n</script>\n\n<style>\n.container {\n  padding: 100px 50px;\n}\n\n.projects {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 50px;\n  justify-items: center;\n  margin-top: 50px;\n}\n\n.project {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 350px;\n}\n\n.picture {\n  width: 350px;\n  height: 220px;\n  border-radius: 5%;\n  transition: 0.3s ease;\n}\n\n.overlay {\n  position: relative;\n  width: 350px;\n  height: 220px;\n  border-radius: 5%;\n  overflow: hidden;\n}\n\n.overlay::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0, 0, 0, 0.281);\n  transition: 0.3s ease;\n  opacity: 0;\n}\n\n.overlay:hover::after {\n  opacity: 1;\n}\n\n.text {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: #6540ca;\n  font-size: 20px;\n  font-weight: bold;\n  visibility: hidden;\n  opacity: 0;\n  transition: visibility 0s, opacity 0.3s ease;\n}\n\n.overlay:hover .text {\n  visibility: visible;\n  opacity: 1;\n}\n\n.project-details {\n  max-width: 350px;\n}\n\n.project-details h2 {\n  margin-top: 0;\n}\n\n.project-details p {\n  margin-top: 5px;\n}\n</style>\n"],"mappings":"AAqFA,eAAe;EACbA,IAAI,EAAE;AACR,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}