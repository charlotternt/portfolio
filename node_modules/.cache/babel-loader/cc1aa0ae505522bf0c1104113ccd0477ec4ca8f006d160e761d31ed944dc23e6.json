{"ast":null,"code":"export default {\n  name: \"about_\"\n};","map":{"version":3,"names":["name"],"sources":["/Users/charlotte/portfolio/src/components/about.vue"],"sourcesContent":["<template>\n  <div>\n    <h3>À propos de moi</h3>\n    <p>\n      Je m'appelle Charlotte RENAULT, j'ai étudié à Epitech Lyon de Novembre\n      2021 à Novembre 2023. J'y ai obtenu un bac+2 en tant que\n      intégratrice/développeuse web.\n    </p>\n    <p>\n      Je suis développeuse web passionnée par le JavaScript et la création\n      d'interfaces interactives. Je développe principalement avec HTML, CSS,\n      JavaScript et Vue.js. Je cherche une opportunité pour continuer à\n      apprendre et contribuer à des projets web.\n    </p>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"about_\",\n};\n</script>\n"],"mappings":"AAkBA,eAAe;EACbA,IAAI,EAAE;AACR,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}